#!/bin/bash
# Keep all Jupyter startup writes on the local filesystem instead of the
# WebDAV/NFS home mount (EGI owncloud sidecars). A slow/blocking home mount
# makes the singleuser server hang before answering /api -> 90s spawn timeout.
export JUPYTER_RUNTIME_DIR=/tmp/jupyter-runtime
export JUPYTER_DATA_DIR=/tmp/jupyter-data
export JUPYTER_CONFIG_DIR=/tmp/jupyter-config
export IPYTHONDIR=/tmp/ipython
mkdir -p "$JUPYTER_RUNTIME_DIR" "$JUPYTER_DATA_DIR" "$JUPYTER_CONFIG_DIR" "$IPYTHONDIR"

exec "$@"
